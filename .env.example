# Documentation only. Copy to a secret manager or an ignored local .env and
# replace every GENERATE/SET_ME value before use.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgresql://moving_company:SET_ME@db:5432/moving_company
JWT_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
CORS_ALLOWED_ORIGINS=https://moving.example.com
TRUST_PROXY_HOPS=1

DOCUMENT_CONNECTOR_ALLOWED_HOSTS=storage.example.com,ocr.example.com,esign.example.com,filing.example.com,templates.example.com
CONNECTOR_TIMEOUT_MS=10000
CONNECTOR_ALLOW_HTTP=false

DOCUMENT_STORAGE_URL=https://storage.example.com/v1/
DOCUMENT_STORAGE_TOKEN=SET_ME
OCR_PROVIDER_URL=https://ocr.example.com/v1/
OCR_PROVIDER_TOKEN=SET_ME
ESIGN_PROVIDER_URL=https://esign.example.com/v1/
ESIGN_PROVIDER_TOKEN=SET_ME
ESIGN_WEBHOOK_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
FILING_PROVIDER_URL=https://filing.example.com/v1/
FILING_PROVIDER_TOKEN=SET_ME
FILING_WEBHOOK_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
TEMPLATE_REGISTRY_URL=https://templates.example.com/v1/
TEMPLATE_REGISTRY_TOKEN=SET_ME
